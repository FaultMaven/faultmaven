# Optional: Specify model name if needed by the local provider (not currently used by Phi3OnnxLocal class)
# LOCAL_LLM_MODEL="Phi-3-mini-128k-instruct-onnx"

MCP_SERVER_URL="http://mcp-server-address"

# --- Other Application Settings ---
SESSION_TIMEOUT=1800 # Example: 30 minutes


