LLM_REQUEST_TIMEOUT=30

# =============================================================================
# Services
# =============================================================================

# Web Search
TAVILY_API_KEY="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"

# MCP Server
MCP_SERVER_URL="http://mcp-server-address"

# =============================================================================
# Infrastructure Services (K8s Cluster)
# =============================================================================

# Redis Session Store (NodePort - TCP protocol requires direct access)
REDIS_HOST="192.168.0.111"
REDIS_PORT=30379
REDIS_PASSWORD="faultmaven-dev-redis-2025"

# =============================================================================
# Observability
# =============================================================================

OPIK_USE_LOCAL=true
OPIK_LOCAL_HOST=opik.faultmaven.local
OPIK_LOCAL_URL=http://opik.faultmaven.local:30080
OPIK_PROJECT_NAME="FaultMaven Development"
OPIK_API_KEY=local-dev-key
COMET_API_KEY="8bldRwlVKtz3IVIjC4t1kZdt8"

# LLM Provider Behavior
STRICT_PROVIDER_MODE=true
SKIP_SERVICE_CHECKS=false

# Feature Flags (Phase 0 Task 1 - Intelligent Prompt System)
ENABLE_INTELLIGENT_PROMPTS=true

# Feature Flags (Enhanced Query Classification System)
# LLM Classification Mode: disabled, fallback, enhancement (recommended), always
LLM_CLASSIFICATION_MODE=enhancement
PATTERN_CONFIDENCE_THRESHOLD=0.7
ENABLE_MULTIDIMENSIONAL_CONFIDENCE=true
CONFIDENCE_OVERRIDE_THRESHOLD=0.4
SELF_CORRECTION_MIN_CONFIDENCE=0.4
SELF_CORRECTION_MAX_CONFIDENCE=0.7

# Legacy flag for backward compatibility (deprecated - use LLM_CLASSIFICATION_MODE instead)
ENABLE_LLM_CLASSIFICATION=true

# Feature Flags (Phase 0 Task 3 - Token-Aware Context Management)
ENABLE_TOKEN_AWARE_CONTEXT=true
ENABLE_CONVERSATION_SUMMARIZATION=true

# =============================================================================
# Conversation and Context Thresholds (ConversationThresholds)
# =============================================================================
# These control conversation flow, token budgets, and classification behavior
# All values are optional - defaults are used if not specified

# Conversation Limits
MAX_CLARIFICATIONS=3                    # Max clarification requests before suggesting escalation
MAX_CONVERSATION_TURNS=20               # Max conversation turns to track in memory
MAX_CONVERSATION_TOKENS=4000            # Max tokens for conversation history

# Token Budget Allocation (for prompt assembly optimization)
CONTEXT_TOKEN_BUDGET=4000               # Total budget for system+user+history (updated from 1500)
SYSTEM_PROMPT_MAX_TOKENS=500            # Max tokens for system prompt (warn if exceeded)
PATTERN_TEMPLATE_MAX_TOKENS=300         # Max tokens for pattern templates

# Note: Classification confidence thresholds are defined above in the classification section
