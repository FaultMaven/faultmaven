# =============================================================================
# FAULTMAVEN CONFIGURATION TEMPLATE
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Configure Section 2 (LLM Provider) and Section 3 (API Keys).
# 3. Everything else has sensible defaults for a Local Deployment.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS (Local Defaults)
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8090
WORKERS=1
LOG_LEVEL=INFO
INSTANCE_ID=local-instance-1

# -----------------------------------------------------------------------------
# 2. LLM PROVIDER SELECTION
# -----------------------------------------------------------------------------
# UNCOMMENT and SET ONE to select your primary chat engine.
# Options: openai, anthropic, fireworks, groq, gemini, cohere, huggingface, local
# CHAT_PROVIDER=

# Optional: Override specific capabilities (defaults to CHAT_PROVIDER if unset)
# MULTIMODAL_PROVIDER=
# SYNTHESIS_PROVIDER=
# CLASSIFIER_PROVIDER=
# CODE_PROVIDER=

# -----------------------------------------------------------------------------
# 3. PROVIDER CREDENTIALS
# -----------------------------------------------------------------------------
# Uncomment and fill the API key for your selected provider(s).

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Cohere
# COHERE_API_KEY=xxx
# COHERE_MODEL=command-r-plus

# Fireworks AI
# FIREWORKS_API_KEY=fw_xxx
# FIREWORKS_MODEL=accounts/fireworks/models/qwen3-coder-480b-a35b-instruct

# Google Gemini
# GEMINI_API_KEY=AIzaSyxxx
# GEMINI_MODEL=gemini-2.5-pro

# Groq
# GROQ_API_KEY=gsk_xxx
# GROQ_MODEL=meta-llama/Llama-3.3-70b-versatile

# HuggingFace
# HUGGINGFACE_API_KEY=hf_xxx
# HUGGINGFACE_MODEL=tiiuae/falcon-7b-instruct

# OpenAI
# OPENAI_API_KEY=sk-proj-xxx
# OPENAI_MODEL=gpt-4o

# OpenRouter
# OPENROUTER_API_KEY=sk-or-xxx
# OPENROUTER_MODEL=openrouter-default

# Local LLM (Ollama/vLLM)
# LOCAL_LLM_URL=http://host.docker.internal:11434
# LOCAL_LLM_MODEL=llama3.2

# -----------------------------------------------------------------------------
# 4. EXTERNAL TOOLS (Search & Web)
# -----------------------------------------------------------------------------
ENABLE_WEB_SEARCH=false
# TAVILY_API_KEY=tvly-xxx
# WEB_SEARCH_API_KEY=xxx
# WEB_SEARCH_ENGINE_ID=xxx

# -----------------------------------------------------------------------------
# 5. LOCAL STORAGE DEFAULTS
# -----------------------------------------------------------------------------
# Default to in-memory storage for simple local testing.
SESSION_STORAGE_TYPE=inmemory
VECTOR_STORAGE_TYPE=inmemory
USER_STORAGE_TYPE=inmemory
CASE_STORAGE_TYPE=inmemory

# -----------------------------------------------------------------------------
# 6. APP BEHAVIOR (Rate Limits & Uploads)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=10
UPLOAD_TIMEOUT_SECONDS=300

# CORS Configuration
# ------------------
# CORS_ALLOW_CREDENTIALS: Allow cookies/auth headers in cross-origin requests
CORS_ALLOW_CREDENTIALS=true

# CORS_ALLOW_ORIGINS: Static list of allowed origins
# Note: In development (ENVIRONMENT=development), the backend automatically
# allows ALL local network IPs (192.168.x.x, 10.x.x.x, 172.16-31.x.x) via regex.
# This enables seamless dashboard access from:
#   - localhost (http://localhost:5173)
#   - Same machine different port (http://localhost:3000)
#   - Phone/tablet on local network (http://192.168.x.x:5173)
#   - Browser extensions (chrome-extension://* and moz-extension://*)
#
# The dynamic local network CORS is ONLY active in development mode.
# Production deployments use strict origin validation from this list only.
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:5173","chrome-extension://*","moz-extension://*"]

# =============================================================================
#  ██████╗ ██╗      ██████╗ ██╗   ██╗██████╗ 
# ██╔════╝ ██║     ██╔═══██╗██║   ██║██╔══██╗
# ██║      ██║     ██║   ██║██║   ██║██║  ██║
# ██║      ██║     ██║   ██║██║   ██║██║  ██║
# ╚██████╗ ███████╗╚██████╔╝╚██████╔╝██████╔╝
#  ╚═════╝ ╚══════╝ ╚═════╝  ╚═════╝ ╚═════╝ 
# ENTERPRISE / CLOUD SETTINGS
# =============================================================================
# The settings below are ONLY for production/cloud deployments.
# Local users can safely ignore everything below this line.
# =============================================================================

# --- A. PERSISTENT STORAGE (Redis & Postgres) ---
# SESSION_STORAGE_TYPE=redis
# REDIS_HOST=redis.faultmaven.local
# REDIS_PORT=6379
# REDIS_PASSWORD=secret_redis_password
# REDIS_DB=0

# USER_STORAGE_TYPE=postgres
# CASE_STORAGE_TYPE=postgres
# AUTH_DB_HOST=postgres.faultmaven.local
# AUTH_DB_PORT=5432
# AUTH_DB_NAME=auth_db
# AUTH_DB_USER=auth_service
# AUTH_DB_PASSWORD=secret_postgres_password
# CASES_DB_HOST=postgres.faultmaven.local
# CASES_DB_PORT=5432
# CASES_DB_NAME=cases_db
# CASES_DB_USER=case_service
# CASES_DB_PASSWORD=secret_cases_password

# --- B. VECTOR DATABASE (ChromaDB) ---
# VECTOR_STORAGE_TYPE=chromadb
# CHROMADB_URL=http://chromadb.faultmaven.local:8090
# CHROMADB_COLLECTION=faultmaven_kb
# CHROMADB_API_KEY=secret_chroma_key

# --- C. OBSERVABILITY & TRACING ---
# OPIK_ENABLED=false
# OPIK_API_KEY=xxx
# OPIK_PROJECT_NAME=FaultMaven
# COMET_API_KEY=xxx

# --- D. SECURITY & PII PROTECTION ---
# PII Scrubbing (Presidio)
# PRESIDIO_ANALYZER_URL=http://presidio-analyzer.faultmaven.local:3000
# PRESIDIO_ANONYMIZER_URL=http://presidio-anonymizer.faultmaven.local:3000

# Authentication (JWT)
# JWT_SECRET_KEY=change_this_to_a_long_random_string_in_prod
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION_HOURS=24

