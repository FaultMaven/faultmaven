# =============================================================================
# FAULTMAVEN CONFIGURATION
# =============================================================================
# Quick Start:
#   1. Copy this file: cp .env.example .env
#   2. Set CHAT_PROVIDER (Section 1) - Uncomment the provider & API key
#   3. Start FaultMaven: ./faultmaven start
#   4. Access Dashboard: http://localhost:3333
# =============================================================================

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ DEPLOYMENT: SELF-HOSTED (LOCAL MODE)                                    │
# ├─────────────────────────────────────────────────────────────────────────┤
# │ This file configures a self-hosted FaultMaven backend.                  │
# │                                                                         │
# │ 🏠 LOCAL MODE (Default - Single User)                                   │
# │    AUTH_MODE=local with simple username authentication.                 │
# │    Access: http://localhost:3333                                        │
# │                                                                         │
# │ 💡 REMOTE SERVER? Use SSH tunnel (keeps config as localhost):           │
# │    ssh -L 3333:localhost:3333 -L 8090:localhost:8090 user@server        │
# │                                                                         │
# │ ☁️  FAULTMAVEN CLOUD SUBSCRIBERS                                        │
# │    You don't need this file. Point your extension directly to:          │
# │    https://app.faultmaven.ai                                            │
# └─────────────────────────────────────────────────────────────────────────┘

# -----------------------------------------------------------------------------
# 1. LLM PROVIDER (REQUIRED)
# -----------------------------------------------------------------------------
# FaultMaven requires an LLM to function.
# Step 1: Uncomment ONE CHAT_PROVIDER line below to select your engine.
# Step 2: Uncomment and set the corresponding API KEY in the credentials section.

# CHAT_PROVIDER=anthropic
# CHAT_PROVIDER=openai
# CHAT_PROVIDER=gemini
# CHAT_PROVIDER=fireworks
# CHAT_PROVIDER=groq
# CHAT_PROVIDER=huggingface
# CHAT_PROVIDER=cohere
# CHAT_PROVIDER=openrouter
# CHAT_PROVIDER=local

# --- Provider Credentials ----------------------------------------------------

# Anthropic Claude (Recommended for Logic)
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI (Recommended for Consistency)
# OPENAI_API_KEY=sk-proj-xxx
# OPENAI_MODEL=gpt-4o

# Google Gemini
# GEMINI_API_KEY=xxx
# GEMINI_MODEL=gemini-2.0-flash

# Fireworks AI (Fast & Cheap)
# FIREWORKS_API_KEY=fw-xxx
# FIREWORKS_MODEL=accounts/fireworks/models/qwen2.5-coder-32b-instruct

# Groq (Ultra Fast Inference)
# GROQ_API_KEY=gsk-xxx
# GROQ_MODEL=meta-llama/Llama-3.3-70b-versatile

# HuggingFace (Open Models)
# HUGGINGFACE_API_KEY=hf_xxx
# HUGGINGFACE_MODEL=mistralai/Mistral-Large-Instruct-2411

# Cohere (Enterprise RAG)
# COHERE_API_KEY=xxx
# COHERE_CHAT_MODEL=command-r-plus

# OpenRouter (Multi-Model Gateway)
# OPENROUTER_API_KEY=sk-or-xxx
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Local LLM (Ollama/vLLM - Private & Offline)
# LOCAL_LLM_URL=http://host.docker.internal:11434
# LOCAL_LLM_MODEL=llama3.2
# Note for Linux: Use http://172.17.0.1:11434 if host.docker.internal fails.

# -----------------------------------------------------------------------------
# 2. CAPABILITY OVERRIDES (OPTIONAL - MIX & MATCH)
# -----------------------------------------------------------------------------
# By default, all tasks use CHAT_PROVIDER. You can override specific agents here.
# Example: Use Claude for chat, but OpenAI for coding tasks.

# CODE_PROVIDER=       # e.g., openai
# MULTIMODAL_PROVIDER= # e.g., anthropic (for image analysis)
# SYNTHESIS_PROVIDER=  # e.g., fireworks (for fast JSON generation)
# CLASSIFIER_PROVIDER= # e.g., groq (for routing)
# DA_PROVIDER=         # e.g., anthropic (for directed analysis turns)

# --- LLM Fallback Behavior ---------------------------------------------------
# STRICT_PROVIDER_MODE controls whether FaultMaven uses only the primary provider
# or automatically falls back to other providers on failure.
#
# Default: true (strict mode) - Use only CHAT_PROVIDER, no automatic fallbacks
#   - Pros: Predictable, transparent, consistent LLM behavior
#   - Cons: Fails if primary provider is down
#
# Set to false for automatic fallback to other providers (fireworks, openai, local)
#   - Pros: Higher availability, automatic recovery from provider failures
#   - Cons: Mixed LLM responses, less predictable behavior
#
STRICT_PROVIDER_MODE=true  # Default: single LLM only (recommended)

# -----------------------------------------------------------------------------
# 3. EXTERNAL TOOLS
# -----------------------------------------------------------------------------
ENABLE_WEB_SEARCH=false
# TAVILY_API_KEY=tvly-xxx

# Document-to-runbook conversion uses CHAT_PROVIDER by default.
# Override with a dedicated provider if desired:
# KNOWLEDGE_PROVIDER=anthropic

# -----------------------------------------------------------------------------
# 4. APP CONFIGURATION
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 5. OBSERVABILITY & TRACING (OPTIONAL)
# -----------------------------------------------------------------------------
# FaultMaven integrates with Opik (by Comet) for LLM tracing and observability.
# Disabled by default. Enable to trace prompts, responses, and decision records.

# --- Core Settings -----------------------------------------------------------
# OPIK_ENABLED=true                           # Enable Opik integration
# OPIK_PROJECT_NAME=faultmaven                # Project name in Opik dashboard
# COMET_WORKSPACE=your-workspace              # Workspace name (used by both local and cloud)

# --- Self-Hosted Opik (Local or K8s) -----------------------------------------
# Pick ONE: self-hosted OR cloud. Do not enable both.
# Use your own Opik instance — local Docker, K8s deployment, or any self-hosted URL.
# See https://github.com/comet-ml/opik for deployment options.
# OPIK_USE_LOCAL=true
# OPIK_LOCAL_URL=http://localhost:5173
# Examples:
#   Local Docker:  OPIK_LOCAL_URL=http://localhost:5173
#   K8s internal:  OPIK_LOCAL_URL=http://opik-api.faultmaven.svc.cluster.local:5173
#   K8s external:  OPIK_LOCAL_URL=https://opik.yourcompany.com

# --- Cloud Opik (Comet ML) ---------------------------------------------------
# Pick ONE: self-hosted OR cloud. Do not enable both.
# To use Comet cloud, comment out OPIK_USE_LOCAL above and uncomment these:
# OPIK_URL_OVERRIDE=https://www.comet.com/opik/api
# OPIK_API_KEY=your-comet-api-key

# --- Prompt Observability -----------------------------------------------------
# Sanitized prompts (PII redacted) are always logged when tracing is active.
# For local debugging, you can also log raw unsanitized prompts:
# OPIK_LOG_RAW_PROMPTS=true                   # Requires OPIK_USE_LOCAL=true

# --- Targeted Tracing (Advanced) ---------------------------------------------
# By default, all requests are traced when enabled. Use these to narrow scope:
# OPIK_TRACK_DISABLE=false                    # Global kill switch (default: true)
# OPIK_TRACK_USERS=user1,user2               # Only trace these users
# OPIK_TRACK_SESSIONS=session-abc            # Only trace these sessions
# OPIK_TRACK_OPERATIONS=llm_query,agent_run  # Only trace these operations

# =============================================================================
# IDENTITY & ACCESS MANAGEMENT (IAM)
# =============================================================================
# Strategy: 'local' (Single User/Self-Hosted) or 'oauth' (Cloud/Multi-User)
AUTH_MODE=local

# --- Common JWT Settings ---
# Token lifetimes in minutes
JWT_ACCESS_TOKEN_EXPIRY=60
JWT_REFRESH_TOKEN_EXPIRY=10080  # 7 days

# --- Local Mode Settings (AUTH_MODE=local) ---
# Symmetric key for signing local tokens. Change this!
JWT_SECRET_KEY=dev-secret-change-me-in-prod

# --- Cloud Mode Settings (AUTH_MODE=oauth) ---
# Paths to RS256 keys for signing/verifying real OAuth tokens
# JWT_PRIVATE_KEY_PATH=/path/to/private.pem
# JWT_PUBLIC_KEY_PATH=/path/to/public.pem
OAUTH_CODE_EXPIRY=10  # Minutes

# --- OAuth Flow & Dashboard ---
OAUTH_REQUIRE_HTTPS_REDIRECT=false
OAUTH_REQUIRE_CONSENT=false
DASHBOARD_URL=http://localhost:3333

# Security & CORS
# STRICT: Only localhost access. Do NOT add wildcard (*) origins.
# Extension schemes (chrome-extension://*) are required for browser extension OAuth.
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_ORIGINS='["http://localhost:3333","http://127.0.0.1:3333","chrome-extension://*","moz-extension://*"]'

# PII Sanitization
# Off by default — FaultMaven is a troubleshooting tool, redacting IPs/hostnames
# defeats security investigations. Enable for privacy-sensitive deployments.
# SANITIZE_PII=true                        # Redact PII before sending to LLM (off by default)

# Upload Limits
MAX_UPLOAD_SIZE_MB=10
UPLOAD_TIMEOUT_SECONDS=300
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# -----------------------------------------------------------------------------
# 6. ADVANCED INFRASTRUCTURE (SELF-HOSTED)
# -----------------------------------------------------------------------------
# Default: SQLite + Local Files + Memory Cache + Embedded ChromaDB
# Only uncomment to override with external services (Production/Enterprise).

# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/faultmaven
# DB_BACKEND=postgres

# CACHE_BACKEND=redis
# REDIS_URL=redis://localhost:6379

# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx
# S3_BUCKET=faultmaven-evidence
# S3_REGION=us-east-1

# VECTOR_BACKEND=chroma
# CHROMADB_URL=http://localhost:8000
# CHROMADB_COLLECTION=faultmaven_kb

# Interpreted Search (LLM-assisted file interpretation)
# Enabled by default (uses CHAT_PROVIDER). No additional config needed.
# To disable: DEEP_ANALYSIS_BACKEND=disabled
# For enterprise external service: DEEP_ANALYSIS_BACKEND=external
# DEEP_ANALYSIS_URL=                      # URL for external backend (enterprise only)
# DEEP_ANALYSIS_API_KEY=                  # API key for external backend (enterprise only)

# Auto-Vectorization (scenario-driven data processing)
# VECTORIZATION_MIN_SIZE_BYTES=50000      # Min file size for auto-vectorization eligibility (bytes)

# Evidence Context Sliding Window (how much structural index the LLM sees)
# EVIDENCE_CONTEXT_RECENT_COUNT=3         # Recent data evidence items with full structural index
# EVIDENCE_CONTEXT_MAX_CHARS_PER_ITEM=4000  # Max chars per item's structural index
# EVIDENCE_CONTEXT_MAX_TOTAL_CHARS=16000    # Max total chars for evidence context section

# For Enterprise Multi-Tenancy:
# TENANT_PROVIDER=multi
# DASHBOARD_URL=https://faultmaven.yourcompany.com
