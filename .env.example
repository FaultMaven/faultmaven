# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║                     FaultMaven Configuration                               ║
# ║                                                                            ║
# ║  Quick Setup:                                                              ║
# ║  1. Copy this file: cp .env.example .env                                   ║
# ║  2. Set ONE LLM provider API key below                                     ║
# ║  3. Run: docker compose up                                                 ║
# ║                                                                            ║
# ║  Everything else has sensible defaults for local deployment.               ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# =============================================================================
# REQUIRED: LLM Provider (choose ONE)
# =============================================================================
# FaultMaven needs an LLM to function. Configure at least one provider below.
# The app will prompt you at startup if no provider is configured.

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Option 1: OpenAI (Recommended for best quality)                             │
# └─────────────────────────────────────────────────────────────────────────────┘
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o                          # Default model (optional)

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Option 2: Anthropic Claude                                                  │
# └─────────────────────────────────────────────────────────────────────────────┘
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514     # Default model (optional)

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Option 3: Local LLM via Ollama (Free, runs on your machine)                 │
# └─────────────────────────────────────────────────────────────────────────────┘
# To use Ollama:
# 1. Install Ollama: https://ollama.ai
# 2. Pull a model: ollama pull llama3.1
# 3. Uncomment and configure below:
# CHAT_PROVIDER=local
# LOCAL_LLM_URL=http://host.docker.internal:11434
# LOCAL_LLM_MODEL=llama3.1

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ Option 4: Other Providers                                                   │
# └─────────────────────────────────────────────────────────────────────────────┘
FIREWORKS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# =============================================================================
# Provider Selection (usually auto-detected from API keys above)
# =============================================================================
# Primary provider for chat/investigation (auto-selects first available if not set)
# Options: openai, anthropic, fireworks, groq, local
# CHAT_PROVIDER=openai

# Specialized providers (all default to CHAT_PROVIDER if not set)
# MULTIMODAL_PROVIDER=openai                   # For image/screenshot analysis
# SYNTHESIS_PROVIDER=openai                    # For document Q&A (use cheaper model)
# CLASSIFIER_PROVIDER=openai                   # For data classification
# CODE_PROVIDER=openai                         # For code analysis

# =============================================================================
# Optional: Web Search
# =============================================================================
# Enable AI-powered web search during investigations
# Get a free API key at: https://tavily.com
TAVILY_API_KEY=
ENABLE_WEB_SEARCH=false

# =============================================================================
# Local Deployment Settings (sensible defaults - usually no changes needed)
# =============================================================================

# Storage Configuration (in-memory for local, external services for production)
SESSION_STORAGE_TYPE=inmemory
VECTOR_STORAGE_TYPE=inmemory
CASE_STORAGE_TYPE=database
DATABASE_URL=sqlite+aiosqlite:///./data/faultmaven.db

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# CORS (allows Dashboard and browser extensions to connect)
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:5173","chrome-extension://*","moz-extension://*"]
CORS_ALLOW_CREDENTIALS=true

# Session Management
SESSION_TIMEOUT_MINUTES=180
MAX_SESSIONS_PER_USER=10

# =============================================================================
# Investigation Framework (OODA)
# =============================================================================
# These control how FaultMaven investigates problems. Defaults work well.

DEFAULT_INVESTIGATION_STRATEGY=active_incident
# Options: active_incident (fast), post_mortem (thorough)

DEFAULT_OODA_INTENSITY=medium
# Options: light (1-2 iterations), medium (2-4), full (3-6)

# =============================================================================
# Advanced: LLM Behavior
# =============================================================================
# STRICT_PROVIDER_MODE=false                   # true = no fallback to other providers
# LLM_REQUEST_TIMEOUT=30                       # Seconds before timeout
# LLM_MAX_RETRIES=3                            # Retry attempts on failure
# LLM_MAX_TOKENS=4096                          # Max tokens per request

# =============================================================================
# Advanced: File Upload Limits
# =============================================================================
MAX_UPLOAD_SIZE_MB=10
# ALLOWED_MIME_TYPES=["text/plain","text/csv","application/json","application/xml","text/xml","application/yaml"]

# =============================================================================
# Advanced: Protection & Rate Limiting
# =============================================================================
PROTECTION_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# PII Sanitization (auto-enabled for cloud LLMs, disabled for local)
AUTO_SANITIZE_BASED_ON_PROVIDER=true

# =============================================================================
# Enterprise/Cloud Settings (ignore for local deployment)
# =============================================================================
# These settings are for FaultMaven Cloud or self-hosted enterprise deployments.
# They require additional infrastructure (Redis, PostgreSQL, ChromaDB, etc.)

# --- Redis (for distributed sessions) ---
# SESSION_STORAGE_TYPE=redis
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# --- PostgreSQL (for production persistence) ---
# CASE_STORAGE_TYPE=postgres_hybrid
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/faultmaven

# --- ChromaDB (for production vector storage) ---
# VECTOR_STORAGE_TYPE=chromadb
# CHROMADB_URL=http://localhost:8001
# CHROMADB_COLLECTION=faultmaven_kb

# --- Observability (Opik tracing) ---
# ENABLE_TRACING=true
# OPIK_LOCAL_URL=http://localhost:5174
# OPIK_PROJECT_NAME=FaultMaven

# --- PII Protection (Presidio) ---
# ENABLE_PII_REDACTION=true
# PRESIDIO_ANALYZER_URL=http://localhost:5002
# PRESIDIO_ANONYMIZER_URL=http://localhost:5003

# --- JWT Authentication ---
# JWT_SECRET_KEY=change-this-in-production
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION_HOURS=24
