#!/bin/bash
#
# FaultMaven pre-commit hook — auto-format STAGED Python files with black.
# Version-controlled; activated by: ./scripts/install-git-hooks.sh
# (sets git config core.hooksPath .githooks).
#
# Design notes (why this exists rather than the old .git/hooks/ script):
#  - Locates a black that actually RUNS. A launcher on PATH can exist yet be
#    broken (ModuleNotFoundError); prefer the project's .venv so it works from a
#    non-activated shell or a GUI git client.
#  - Operates ONLY on staged *.py files and re-stages only those, so unrelated
#    unstaged changes never trigger a false "please re-stage" abort.
#  - Warns if the resolved black version differs from the pin CI enforces
#    (CI runs `black --check`; formatting output is version-sensitive).
#  - Skips cleanly (exit 0) when black is unavailable — never blocks a commit
#    just because the formatter isn't installed.

set -uo pipefail

YELLOW='\033[1;33m'; GREEN='\033[0;32m'; NC='\033[0m'

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# Worktrees do not carry their own virtualenv — they share the main checkout's,
# and REPO_ROOT points at the worktree. Looking only there meant every commit
# made from a worktree silently skipped formatting, which is where agent-driven
# work mostly happens. Resolve the main checkout via git-common-dir and search
# it too. Empty when git cannot answer; the -n guard below skips those entries.
COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
MAIN_ROOT="${COMMON_DIR:+$(dirname "$COMMON_DIR")}"

# Pick a black that actually runs. Try explicit binaries first (quoted, so paths
# with spaces are safe), then fall back to `python -m black`. BLACK is an array
# so multi-word forms expand correctly.
#
# Every candidate is probed with --version rather than trusted for existing: a
# launcher on PATH can be present and broken (a ~/.local/bin shim whose package
# was installed for a different interpreter raises ModuleNotFoundError), and
# picking it would abort commits instead of formatting them.
BLACK=()
for bin in \
    "${VIRTUAL_ENV:+$VIRTUAL_ENV/bin/black}" \
    "$REPO_ROOT/.venv/bin/black" \
    "${MAIN_ROOT:+$MAIN_ROOT/.venv/bin/black}" \
    "${MAIN_ROOT:+$MAIN_ROOT/.venv-dev/bin/black}" \
    "$(command -v black 2>/dev/null || true)"; do
    [ -n "$bin" ] || continue
    if "$bin" --version >/dev/null 2>&1; then BLACK=("$bin"); break; fi
done
if [ ${#BLACK[@]} -eq 0 ]; then
    for py in python3 python; do
        if command -v "$py" >/dev/null 2>&1 && "$py" -m black --version >/dev/null 2>&1; then
            BLACK=("$py" -m black); break
        fi
    done
fi

if [ ${#BLACK[@]} -eq 0 ]; then
    echo -e "${YELLOW}⚠ black not runnable — skipping auto-format (pip install -e \".[dev]\")${NC}"
    exit 0
fi

# Warn on version drift from the pin CI checks against (keeps local == CI).
PINNED="$("$REPO_ROOT/scripts/black-pinned-version.sh" 2>/dev/null || true)"
HAVE="$("${BLACK[@]}" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1)"
if [ -n "$PINNED" ] && [ -n "$HAVE" ] && [ "$PINNED" != "$HAVE" ]; then
    echo -e "${YELLOW}⚠ black $HAVE differs from pinned $PINNED — CI runs 'black --check', formatting may diverge.${NC}"
    echo -e "${YELLOW}  Fix: pip install black==$PINNED${NC}"
fi

# .env.example <-> settings.py default-sync guard — runs only when either is
# staged. Keeps the documented defaults from drifting from the code defaults.
if git diff --cached --name-only --diff-filter=ACM \
     | grep -qE '^(\.env\.example|faultmaven/config/settings\.py)$'; then
    SYNC_PY=""
    for cand in "${VIRTUAL_ENV:+$VIRTUAL_ENV/bin/python}" "$REPO_ROOT/.venv/bin/python" "$(command -v python3 || true)"; do
        [ -n "$cand" ] || continue
        if "$cand" -c 'import pydantic_settings' >/dev/null 2>&1; then SYNC_PY="$cand"; break; fi
    done
    if [ -n "$SYNC_PY" ]; then
        if ! "$SYNC_PY" "$REPO_ROOT/scripts/check_env_example_sync.py"; then
            echo -e "${YELLOW}✗ .env.example is out of sync with settings.py — commit aborted${NC}"
            exit 1
        fi
    else
        echo -e "${YELLOW}⚠ skipping .env.example sync check (no python with pydantic_settings)${NC}"
    fi
fi

# Staged Python files only (Added/Copied/Modified), NUL-safe for odd names.
mapfile -d '' -t STAGED < <(git diff --cached --name-only --diff-filter=ACM -z -- '*.py')
[ ${#STAGED[@]} -eq 0 ] && exit 0

echo -e "${YELLOW}Running black on ${#STAGED[@]} staged Python file(s)...${NC}"
if ! "${BLACK[@]}" -q -- "${STAGED[@]}"; then
    echo -e "${YELLOW}⚠ black reported an error — commit aborted${NC}"
    exit 1
fi

# Re-stage ONLY the staged files black may have reformatted.
restaged=0
for f in "${STAGED[@]}"; do
    if [ -e "$REPO_ROOT/$f" ] && ! git diff --quiet -- "$f"; then
        git add -- "$f"
        restaged=1
    fi
done

if [ "$restaged" -eq 1 ]; then
    echo -e "${GREEN}✓ black reformatted staged file(s); re-staged automatically${NC}"
else
    echo -e "${GREEN}✓ staged Python already formatted${NC}"
fi
exit 0
