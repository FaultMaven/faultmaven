    %% ============================================================
    classDef settings fill:#e1bee7,stroke:#6a1b9a,stroke-width:2px,color:#4a148c
    classDef infra fill:#ffccbc,stroke:#d84315,color:#bf360c
    classDef tools fill:#fff9c4,stroke:#f9a825,color:#f57f17
    classDef services fill:#c8e6c9,stroke:#2e7d32,color:#1b5e20
    classDef state fill:#bbdefb,stroke:#1565c0,stroke-width:3px,color:#0d47a1
    classDef note fill:#f5f5f5,stroke:#9e9e9e,stroke-dasharray: 5 5,color:#424242

    class Settings settings
    class Infra_LLM,Infra_Vec,Infra_Session,Infra_Persist,Infra_Prep infra
    class Tools_Ingest,Tools_QA,Tools_Registry tools
    class Svc_Auth,Svc_Case,Svc_Other services
    class AppState state
    class Order note
